# Public URL of Drivecord (what is probed).
DRIVECORD_ORIGIN="https://drivecord.app"
# Separate domain serving public files (same value as USERCONTENT_ORIGIN in Drivecord). Empty = component hidden.
USERCONTENT_ORIGIN=""
# Optional overrides (defaults shown in src/lib/components.ts).
CORD_ISSUER="https://compte.cordsuite.app"
CORD_HUB_URL="https://www.cordsuite.app"

# Public URL of this status page (feed, links in the JSON API).
NEXT_PUBLIC_SITE_URL="https://status.drivecord.app"

# History store: Upstash Redis / Vercel KV (REST). Without it, history lives in memory (lost on restart).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Shared secret for /api/cron/probe (Vercel Cron sends it as "Authorization: Bearer <value>").
CRON_SECRET=""

# Optional: raises the GitHub API rate limit used to date the changelog entries.
GITHUB_TOKEN=""
