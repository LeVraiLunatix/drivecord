# ── Base de données ──────────────────────────────────────────
# Chaîne de connexion PostgreSQL (Neon, Supabase, Vercel Postgres, local…)
# Runtime applicatif : utilise l'URL *poolée* (Neon : hôte avec "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/drivecord"
# Migrations Prisma : URL *directe* (non poolée). Sur Neon, hôte SANS "-pooler".
# En PostgreSQL local classique, identique à DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/drivecord"

# ── Auth.js / NextAuth v5 ────────────────────────────────────
# Génère une valeur avec :  npx auth secret
AUTH_SECRET=""
# URL de base — souvent inutile sur Vercel, utile en local
# AUTH_URL="http://localhost:3000"

# Clé de chiffrement serveur (AES-256-GCM) — 64 caractères hexadécimaux (32 octets).
# Génère :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── OAuth (optionnel) ────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ── Bot Discord (optionnel) ──────────────────────────────────
# Token du bot Drivebot — jamais exposé côté client. Permissions requises
# selon les features activées (voir chaque variable ci-dessous) :
#   - Synchro des rôles Patreon (DISCORD_GUILD_ID)      : Gérer les rôles
#   - Configuration automatique de drive (STORAGE_GUILD) : Gérer les salons,
#     Gérer les webhooks, Gérer les rôles (requis par Discord pour accorder
#     une permission de salon au propriétaire du drive, pas juste au bot)
DISCORD_BOT_TOKEN=""
# Serveur Discord "communauté" où le bot synchronise les rôles Gold/Premium/
# VIP selon le palier Patreon (voir src/lib/discord-roles.ts).
DISCORD_GUILD_ID=""
DISCORD_ROLE_GOLD=""
DISCORD_ROLE_PREMIUM=""
DISCORD_ROLE_VIP=""
# Serveur Discord où "Configuration automatique" (page /setup) crée un salon
# privé + un webhook par utilisateur (voir src/lib/discord/storage-guild.ts).
# Volontairement distinct de DISCORD_GUILD_ID : un serveur Discord est
# plafonné à ~500 salons, donc ce guild de stockage devra probablement être
# remplacé/éclaté à terme, indépendamment du serveur communauté/rôles.
# Peut pointer vers le même serveur que DISCORD_GUILD_ID pour commencer.
DISCORD_STORAGE_GUILD_ID=""
# Clé publique de l'app du bot (portail développeur → General Information) —
# vérifie la signature des Interactions Discord (bouton "Se vérifier" du
# salon #✅・vérification, voir src/app/api/discord/interactions/route.ts).
# Nécessite d'enregistrer "https://<ton-domaine>/api/discord/interactions"
# comme "Interactions Endpoint URL" sur le portail développeur — Discord
# valide l'URL par un PING dès l'enregistrement, donc à faire APRÈS déploiement.
DISCORD_BOT_PUBLIC_KEY=""

# ── Email / Resend ───────────────────────────────────────────
# Clé API Resend (vérification email, codes de connexion, 2FA).
# Convention Auth.js : la variable se nomme AUTH_RESEND_KEY.
AUTH_RESEND_KEY=""
# Expéditeur des emails (domaine vérifié sur Resend).
EMAIL_FROM="Drivecord <no-reply@drivecord.app>"

# ── WebAuthn / Passkeys (optionnel — fallback automatique) ────
# Si non définis, le serveur déduit ces valeurs de l'origine de la requête en
# production, et retombe sur "localhost" en développement.
# RP_ID  = domaine (Relying Party ID) : "drivecord.app" en prod, "localhost" en dev.
RP_ID=""
# RP_NAME = nom affiché lors de l'enregistrement d'un passkey.
RP_NAME="Drivecord"
# WEBAUTHN_ORIGIN = origine complète attendue : "https://drivecord.app" en prod.
WEBAUTHN_ORIGIN=""

# ── 2FA / TOTP (optionnel) ───────────────────────────────────
# Émetteur affiché dans l'app d'authentification (Google Authenticator, Authy…).
TOTP_ISSUER="Drivecord"

# ── Admin (optionnel) ────────────────────────────────────────
# E-mail qui obtient l'accès à l'espace admin
ADMIN_EMAIL=""

# ── Push iOS / APNs (optionnel — approbation de connexion) ───
# Sans ces variables, l'approbation cross-device marche par polling web ;
# avec, les appareils de confiance reçoivent une notification push native.
# Clé .p8 créée sur developer.apple.com → Keys (cocher APNs).
# APNS_TEAM_ID  = Team ID Apple (10 caractères, en haut à droite du portail).
APNS_TEAM_ID=""
# APNS_KEY_ID   = Key ID de la clé .p8.
APNS_KEY_ID=""
# APNS_PRIVATE_KEY = contenu complet du fichier .p8 (les \n littéraux sont acceptés).
APNS_PRIVATE_KEY=""
# APNS_TOPIC    = bundle id de l'app (défaut : com.lunatix.drivecord).
APNS_TOPIC="com.lunatix.drivecord"
# APNS_ENV      = "production" (TestFlight/App Store et builds locaux signés) ou "sandbox" (dev Xcode).
APNS_ENV="production"
